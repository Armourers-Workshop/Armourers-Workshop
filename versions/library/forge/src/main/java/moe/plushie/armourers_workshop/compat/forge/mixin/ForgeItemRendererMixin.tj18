package moe.plushie.armourers_workshop.compat.forge.mixin;

import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.compat.forge.AbstractForgeItemStackRenderer;
import moe.plushie.armourers_workshop.compat.forge.AbstractForgeItemStackRendererProvider;
import net.minecraft.world.item.Item;
import org.spongepowered.asm.mixin.Mixin;
import org.spongepowered.asm.mixin.Shadow;

@Available("[18, 21)")
@Mixin(Item.class)
public abstract class ForgeItemRendererMixin implements AbstractForgeItemStackRendererProvider {

    @Shadow(remap = false)
    private Object renderProperties;

    @Override
    public void setItemRenderer(AbstractForgeItemStackRenderer data) {
        renderProperties = data;
    }
}
