package moe.plushie.armourers_workshop.compat.forge.extensions.net.minecraft.core.Registry;

import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.compat.client.renderer.item.AbstractItemSpecialRenderer;
import moe.plushie.armourers_workshop.compat.forge.AbstractForgeClientEventsImpl;
import moe.plushie.armourers_workshop.core.client.special.SpecialModelRendererType;
import moe.plushie.armourers_workshop.core.utils.TypedProvider;

import manifold.ext.rt.api.Extension;
import manifold.ext.rt.api.ThisClass;

@Available("[26, )")
@Extension
public class SpecialModelRendererExt {

    public static TypedProvider<SpecialModelRendererType<?>> createSpecialModelRendererRegistryFO(@ThisClass Class<?> clazz) {
        return TypedProvider.passthrough((registryName, value) -> {
            AbstractForgeClientEventsImpl.SPECIAL_MODEL_RENDERER_REGISTRY.listen(event -> {
                event.register(registryName.get(), AbstractItemSpecialRenderer.getCodec(value));
            });
        });
    }
}
