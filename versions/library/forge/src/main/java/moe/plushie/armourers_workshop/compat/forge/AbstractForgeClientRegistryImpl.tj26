package moe.plushie.armourers_workshop.compat.forge;

import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.compat.client.AbstractClientRegistry;
import moe.plushie.armourers_workshop.compat.client.gui.renderer.AbstractComposeGuiGraphicsState;
import moe.plushie.armourers_workshop.compat.client.gui.renderer.AbstractComposeGuiGraphicsRenderer;
import net.minecraft.client.renderer.GameRenderer;

@Available("[1.26, )")
public abstract class AbstractForgeClientRegistryImpl extends AbstractClientRegistry {

    @Override
    protected void init() {
        super.init();
        GameRenderer.registerPictureInPictureRendererFO(AbstractComposeGuiGraphicsState.class, AbstractComposeGuiGraphicsRenderer::new);
    }
}
