package moe.plushie.armourers_workshop.compat.forge;

import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.core.capability.SkinWardrobe;
import moe.plushie.armourers_workshop.core.utils.Objects;
import moe.plushie.armourers_workshop.core.utils.OpenResourceLocation;
import net.minecraft.world.entity.Entity;
import net.minecraftforge.common.capabilities.Capability;
import net.minecraftforge.common.capabilities.CapabilityManager;
import net.minecraftforge.common.capabilities.CapabilityToken;
import net.minecraftforge.common.capabilities.ICapabilityProvider;
import net.minecraftforge.common.capabilities.RegisterCapabilitiesEvent;
import net.minecraftforge.event.AttachCapabilitiesEvent;

import java.util.Optional;
import java.util.function.Function;
import java.util.function.Supplier;

@Available("[1.18, 1.21)")
public class AbstractForgeCapabilityImpl<T> {

    protected void registerCapability(OpenResourceLocation registryName, Class<T> type, Function<Entity, Optional<ICapabilityProvider>> provider) {
        // setup event bus.
        var handler = new Handler(registryName, type, provider);
        AbstractForgeInitializer.getEventBus().addGenericListener(Entity.class, handler::attachEntityCapability);
        AbstractForgeInitializer.getModEventBus().addListener(handler::registerCapability);
    }

    protected Supplier<Capability<T>> createCapability(Class<T> type) {
        Capability<T> capability = CapabilityManager.get(Objects.unsafeCast(createCapability0(type)));
        return () -> capability;
    }

    private CapabilityToken<?> createCapability0(Class<?> type) {
        // it recognized the target class by the runtime, so we can't use generic class. this is a trap!!!
        if (type == SkinWardrobe.class) {
            return new CapabilityToken<SkinWardrobe>() {
            };
        }
        throw new AssertionError("not supported capability type: " + type);
    }

    private class Handler {

        private final Class<T> type;
        private final OpenResourceLocation registryName;
        private final Function<Entity, Optional<ICapabilityProvider>> provider;

        public Handler(OpenResourceLocation registryName, Class<T> type, Function<Entity, Optional<ICapabilityProvider>> provider) {
            this.type = type;
            this.registryName = registryName;
            this.provider = provider;
        }

        public void registerCapability(RegisterCapabilitiesEvent event) {
            event.register(type);
        }

        public void attachEntityCapability(AttachCapabilitiesEvent<Entity> event) {
            provider.apply(event.getObject()).ifPresent(it -> {
                event.addCapability(registryName.get(), it);
            });
        }
    }
}
