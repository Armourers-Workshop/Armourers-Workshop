package moe.plushie.armourers_workshop.compat.client.renderer.item;

import com.mojang.blaze3d.vertex.PoseStack;
import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.api.annotation.Dist;
import moe.plushie.armourers_workshop.api.annotation.OnlyIn;
import moe.plushie.armourers_workshop.compat.api.entity.EntityAccessor;
import moe.plushie.armourers_workshop.compat.client.entity.state.AbstractItemStackRenderState;
import moe.plushie.armourers_workshop.compat.client.item.AbstractItemDisplayContext;
import moe.plushie.armourers_workshop.compat.client.renderer.graphics.AbstractGraphicsRenderer;
import moe.plushie.armourers_workshop.core.client.render.EmbeddedItemStackRenderer;
import moe.plushie.armourers_workshop.core.client.render.model.EmbeddedItemModel;
import moe.plushie.armourers_workshop.core.client.render.state.EntityRenderState;
import moe.plushie.armourers_workshop.core.utils.Objects;
import moe.plushie.armourers_workshop.core.utils.OpenItemDisplayContext;
import moe.plushie.armourers_workshop.init.ModDebugger;
import net.minecraft.client.multiplayer.ClientLevel;
import net.minecraft.client.renderer.SubmitNodeCollector;
import net.minecraft.client.renderer.item.ItemModel;
import net.minecraft.client.renderer.item.ItemModelResolver;
import net.minecraft.client.renderer.item.ItemStackRenderState;
import net.minecraft.client.renderer.special.SpecialModelRenderer;
import net.minecraft.client.resources.model.cuboid.ItemTransform;
import net.minecraft.client.resources.model.cuboid.ItemTransforms;
import net.minecraft.world.entity.Entity;
import net.minecraft.world.entity.ItemOwner;
import net.minecraft.world.item.ItemDisplayContext;
import net.minecraft.world.item.ItemStack;
import org.jetbrains.annotations.Nullable;
import org.joml.Vector3f;
import org.joml.Vector3fc;

import java.util.function.Consumer;

@Available("[26, )")
@OnlyIn(Dist.CLIENT)
public class AbstractEmbeddedItemRenderer implements SpecialModelRenderer<ItemStack>, ItemModel {

    //
    private static final ItemTransforms EMPTY_ITEM_TRANSFORMS = new ItemTransforms(
//            ItemTransform thirdPersonLeftHand,
//            ItemTransform thirdPersonRightHand,
//            ItemTransform firstPersonLeftHand,
//            ItemTransform firstPersonRightHand,
//            ItemTransform head,
//            ItemTransform gui,
//            ItemTransform ground,
//            ItemTransform fixed,
//            ItemTransform fixedFromBottom
            new ItemTransform(new Vector3f(), new Vector3f(-0.5f, 0.5f, 0.5f), new Vector3f(1.0f, 1.0f, 1.0f)),
            new ItemTransform(new Vector3f(), new Vector3f(0.5f, 0.5f, 0.5f), new Vector3f(1.0f, 1.0f, 1.0f)),
            new ItemTransform(new Vector3f(), new Vector3f(-0.5f, 0.5f, 0.5f), new Vector3f(1.0f, 1.0f, 1.0f)),
            new ItemTransform(new Vector3f(), new Vector3f(0.5f, 0.5f, 0.5f), new Vector3f(1.0f, 1.0f, 1.0f)),
            new ItemTransform(new Vector3f(), new Vector3f(0.5f, 0.5f, 0.5f), new Vector3f(1.0f, 1.0f, 1.0f)),
            new ItemTransform(new Vector3f(), new Vector3f(0.5f, 0.5f, 0.5f), new Vector3f(1.0f, 1.0f, 1.0f)),
            new ItemTransform(new Vector3f(), new Vector3f(0.5f, 0.5f, 0.5f), new Vector3f(1.0f, 1.0f, 1.0f)),
            new ItemTransform(new Vector3f(), new Vector3f(0.5f, 0.5f, 0.5f), new Vector3f(1.0f, 1.0f, 1.0f)),
            new ItemTransform(new Vector3f(), new Vector3f(0.5f, 0.5f, 0.5f), new Vector3f(1.0f, 1.0f, 1.0f))
    );

    private final EmbeddedItemModel itemModel;
    private final OriginalRenderState originRenderState = new OriginalRenderState();

    private OpenItemDisplayContext originDisplayContext = OpenItemDisplayContext.NONE;

    public AbstractEmbeddedItemRenderer(EmbeddedItemModel itemModel) {
        this.itemModel = itemModel;
    }

    @Nullable
    public static AbstractEmbeddedItemRenderer from(ItemStack itemStack, ItemStackRenderState renderState, ItemModelResolver itemModelResolver, ItemDisplayContext displayContext, @Nullable ClientLevel level, @Nullable ItemOwner itemOwner, ItemModel originItemModel) {
        //
        if (renderState instanceof OriginalRenderState) {
            return null;
        }

        var entity = Objects.safeCast(itemOwner, Entity.class);
        var itemRenderState = AbstractItemStackRenderState.wrap(itemStack, itemModelResolver, level, entity, originItemModel);
        var itemModel = EmbeddedItemStackRenderer.extract(itemStack, itemRenderState, entity);
        if (itemModel == null) {
            return null;
        }

        // we required an entity state for render embedded item model.
        itemModel.setEntityRenderState(Objects.flatMap(entity, it -> {
            var entityRenderState = new EntityRenderState();
            EntityRenderState.extract((EntityAccessor) it, entityRenderState);
            return entityRenderState;
        }));

        return new AbstractEmbeddedItemRenderer(itemModel);
    }

    @Override
    public final void update(ItemStackRenderState renderState, ItemStack itemStack, ItemModelResolver modelResolver, ItemDisplayContext displayContext, @Nullable ClientLevel clientLevel, @Nullable ItemOwner itemOwner, int i) {
        renderState.appendModelIdentityElement(this);
        var renderLayer = renderState.newLayer();
        if (itemStack.hasFoil()) {
            var foilType = ItemStackRenderState.FoilType.STANDARD;
            renderLayer.setFoilType(foilType);
            renderState.setAnimated();
            renderState.appendModelIdentityElement(foilType);
        }
        renderLayer.setupSpecialModel(this, extractArgument(itemStack));
        renderLayer.setUsesBlockLight(true);
        //renderLayer.setParticleIcon(particleIcon);
        renderLayer.setItemTransform(EMPTY_ITEM_TRANSFORMS.getTransform(displayContext));

        // extract the original item stack state into temp render state for render it later.
        modelResolver.updateForTopItem(originRenderState, itemStack, displayContext, clientLevel, itemOwner, i);
        originDisplayContext = AbstractItemDisplayContext.wrap(displayContext);
    }

    @Override
    public final void submit(@Nullable ItemStack argument, PoseStack poseStack, SubmitNodeCollector submitNodeCollector, int lightCoords, int overlayCoords, boolean hasFoil, int outlineColor) {
        var count = EmbeddedItemStackRenderer.render(itemModel, lightCoords, overlayCoords, originDisplayContext, AbstractGraphicsRenderer.wrap(poseStack, submitNodeCollector));
        if (count != 0 && !ModDebugger.itemOverride) {
            return;
        }
        originRenderState.submit(poseStack, submitNodeCollector, lightCoords, overlayCoords, outlineColor);
    }

    @Override
    public final void getExtents(Consumer<Vector3fc> output) {
    }

    @Override
    public final ItemStack extractArgument(ItemStack itemStack) {
        return itemStack;
    }

    protected static class OriginalRenderState extends ItemStackRenderState {
        // nop
    }
}
