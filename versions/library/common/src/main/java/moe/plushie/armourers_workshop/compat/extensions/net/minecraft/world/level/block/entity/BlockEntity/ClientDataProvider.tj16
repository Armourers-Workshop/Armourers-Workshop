package moe.plushie.armourers_workshop.compat.extensions.net.minecraft.world.level.block.entity.BlockEntity;

import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.compat.client.renderer.blockentity.AbstractBlockEntityRendererImpl;
import net.minecraft.client.renderer.blockentity.BlockEntityRenderDispatcher;
import net.minecraft.world.level.block.entity.BlockEntity;

import java.util.function.DoubleSupplier;

import manifold.ext.rt.api.Extension;
import manifold.ext.rt.api.This;

@Available("[1.16, 1.18)")
@Extension
public class ClientDataProvider {

    public static DoubleSupplier createViewDistanceProvider(@This BlockEntity blockEntity) {
        var blockEntityRenderer = BlockEntityRenderDispatcher.instance.getRenderer(blockEntity);
        if (blockEntityRenderer instanceof AbstractBlockEntityRendererImpl<?> impl) {
            return impl::getViewDistance;
        }
        return () -> 64;
    }
}
