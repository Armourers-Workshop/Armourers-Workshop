package moe.plushie.armourers_workshop.compat.extensions.net.minecraft.client.renderer.item.ItemModel;

import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.compat.client.AbstractItemDisplayContext;
import moe.plushie.armourers_workshop.compat.client.AbstractItemTransform;
import moe.plushie.armourers_workshop.core.utils.OpenItemDisplayContext;
import moe.plushie.armourers_workshop.core.utils.OpenItemTransform;
import net.minecraft.client.renderer.item.BlockModelWrapper;
import net.minecraft.client.renderer.item.ItemModel;

import manifold.ext.rt.api.Extension;
import manifold.ext.rt.api.This;

@Available("[1.22, )")
@Extension
public class ABI {

    public static OpenItemTransform getTransform(@This ItemModel itemModel, OpenItemDisplayContext transformType) {
        if (itemModel instanceof BlockModelWrapper wrapper) {
            var transform = wrapper.properties.transforms().getTransform(AbstractItemDisplayContext.unwrap(transformType));
            return AbstractItemTransform.wrap(transform);
        }
        return OpenItemTransform.NO_TRANSFORM;
    }
}
