package moe.plushie.armourers_workshop.compat.client.entity.state;

import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.core.client.render.state.BlockEntityRenderState;
import moe.plushie.armourers_workshop.core.client.render.state.EntityRenderState;
import moe.plushie.armourers_workshop.core.client.render.state.RenderState;
import moe.plushie.armourers_workshop.core.client.render.state.RenderStateManager;
import moe.plushie.armourers_workshop.core.data.DataContainer;
import moe.plushie.armourers_workshop.core.utils.Collections;
import moe.plushie.armourers_workshop.core.utils.Objects;
import moe.plushie.armourers_workshop.core.utils.OpenEquipmentSlot;
import moe.plushie.armourers_workshop.core.utils.TickUtils;
import net.minecraft.client.Minecraft;
import net.minecraft.client.renderer.entity.state.HumanoidRenderState;
import net.minecraft.world.entity.Entity;
import net.minecraft.world.item.ItemStack;
import net.minecraft.world.level.block.entity.BlockEntity;

import java.util.HashMap;
import java.util.List;

@Available("[1.26, )")
public class AbstractRenderState {

    private static final Storage STORAGE = new Storage();

    public static <T extends Entity, S extends EntityRenderState> S create(T entity, float f, float partialTick) {
        var entityRenderer = Minecraft.getInstance().getEntityRenderDispatcher().getRenderer(entity);
        var entityRenderState = entityRenderer.createRenderState(entity, partialTick);
        return wrap(entityRenderState);
    }

    @SuppressWarnings("UnusedReturnValue")
    public static <T extends Entity, S extends EntityRenderState> S createAndExtract(net.minecraft.client.renderer.entity.state.EntityRenderState renderState, T entity, float partialTick) {
        EntityImpl<T, S> impl = STORAGE.getOrCreate(renderState);
        if (impl != null) {
            return impl.updateRenderState(entity, partialTick);
        }
        return null;
    }

    @SuppressWarnings("UnusedReturnValue")
    public static <T extends BlockEntity, S extends BlockEntityRenderState> S createAndExtract(net.minecraft.client.renderer.blockentity.state.BlockEntityRenderState renderState, T entity, float partialTick) {
        BlockEntityImpl<T, S> impl = STORAGE.getOrCreate(renderState);
        if (impl != null) {
            return impl.updateRenderState(entity, partialTick);
        }
        return null;
    }

    public static <T extends Entity, S extends EntityRenderState> S wrap(net.minecraft.client.renderer.entity.state.EntityRenderState renderState) {
        EntityImpl<T, S> impl = STORAGE.get(renderState);
        if (impl != null) {
            return impl.renderState();
        }
        return null;
    }

    public static <T extends BlockEntity, S extends BlockEntityRenderState> S wrap(net.minecraft.client.renderer.blockentity.state.BlockEntityRenderState renderState) {
        BlockEntityImpl<T, S> impl = STORAGE.get(renderState);
        if (impl != null) {
            return impl.renderState();
        }
        return null;
    }

    public static <T extends Entity, S extends EntityRenderState, R extends net.minecraft.client.renderer.entity.state.EntityRenderState> R unwrap(EntityRenderState renderState) {
        EntityImpl<T, S> impl = STORAGE.get(renderState);
        if (impl != null) {
            return Objects.unsafeCast(impl.ref);
        }
        return null;
    }

    public static <T extends BlockEntity, S extends BlockEntityRenderState, R extends net.minecraft.client.renderer.blockentity.state.BlockEntityRenderState> R unwrap(BlockEntityRenderState renderState) {
        BlockEntityImpl<T, S> impl = STORAGE.get(renderState);
        if (impl != null) {
            return Objects.unsafeCast(impl.ref);
        }
        return null;
    }

    public static <T extends Entity, S extends EntityRenderState> void activate(EntityRenderState renderState) {
        EntityImpl<T, S> impl = STORAGE.get(renderState);
        if (impl != null) {
            impl.activate();
        }
    }

    public static <T extends Entity, S extends EntityRenderState> void deactivate(EntityRenderState renderState) {
        EntityImpl<T, S> impl = STORAGE.get(renderState);
        if (impl != null) {
            impl.deactivate();
        }
    }

    private static class Storage {

        private final DataContainer.Key<Object> key = DataContainer.key("RenderState");

        public <T> T get(Object owner) {
            if (owner != null) {
                return Objects.unsafeCast(_get(owner));
            }
            return null;
        }

        public <T> T getOrCreate(Object owner) {
            if (owner != null) {
                return Objects.unsafeCast(_getOrCreate(owner));
            }
            return null;
        }

        public <T> void set(Object owner, T value) {
            DataContainer.set(owner, key, value);
        }

        private Object _get(Object owner) {
            return DataContainer.get(owner, key);
        }

        private Object _getOrCreate(Object owner) {
            var value = DataContainer.get(owner, key);
            if (value != null) {
                return value;
            }
            value = _create(owner);
            if (value != null) {
                DataContainer.set(owner, key, value);
                return value;
            }
            return null;
        }

        private AbstractImpl<?, ?> _create(Object owner) {
            if (owner instanceof net.minecraft.client.renderer.entity.state.EntityRenderState renderState) {
                return new EntityImpl<>(renderState);
            }
            if (owner instanceof net.minecraft.client.renderer.blockentity.state.BlockEntityRenderState renderState) {
                return new BlockEntityImpl<>(renderState);
            }
            return null;
        }
    }

    private abstract static class AbstractImpl<T, S extends RenderState> {

        protected float partialTick = 0;

        protected S renderState;
        protected RenderStateManager<T, S> manager;

        public final S updateRenderState(T entity, float partialTick) {
            this.partialTick = partialTick;
            if (this.renderState == null) {
                this.createRenderState(entity);
            }
            this.extractRenderState(entity, partialTick);
            return this.renderState;
        }

        public final S renderState() {
            return renderState;
        }

        protected void createRenderState(T entity) {
            this.manager = RenderStateManager.create(entity);
            this.renderState = manager.createRenderState(entity);
            // link the impl to the render state.
            STORAGE.set(renderState, this);
        }

        protected void extractRenderState(T entity, float partialTick) {
            manager.extractRenderState(entity, renderState);
        }
    }

    private static class EntityImpl<T extends Entity, S extends EntityRenderState> extends AbstractImpl<T, S> {

        private static final List<OpenEquipmentSlot> ARMOUR_SLOTS = Collections.immutableList(builder -> {
            builder.add(OpenEquipmentSlot.HEAD);
            builder.add(OpenEquipmentSlot.CHEST);
            builder.add(OpenEquipmentSlot.LEGS);
            builder.add(OpenEquipmentSlot.FEET);
        });

        private final HashMap<OpenEquipmentSlot, ItemStack> disabledEquipmentItems = new HashMap<>();

        private final net.minecraft.client.renderer.entity.state.EntityRenderState ref;

        private EntityImpl(net.minecraft.client.renderer.entity.state.EntityRenderState ref) {
            this.ref = ref;
        }

        protected void activate() {
            // TODO: NO IMPL - 1.26
//            if (renderState.isLimitLimbs() && entity instanceof LivingEntity livingEntity) {
//                livingEntity.applyLimitLimbs();
//            }

            // apply the armour slot into render state.
            for (var slotType : ARMOUR_SLOTS) {
                if (!renderState.shouldRenderEquipment(slotType)) {
                    var oldItemStack = setItem(ref, slotType, ItemStack.EMPTY);
                    disabledEquipmentItems.put(slotType, oldItemStack);
                }
            }
        }

        protected void deactivate() {
            // restore the armour slot into render state.
            for (var entry : disabledEquipmentItems.entrySet()) {
                var oldItemStack = entry.getValue();
                setItem(ref, entry.getKey(), oldItemStack);
            }
            disabledEquipmentItems.clear();
        }


        @Override
        protected void extractRenderState(T entity, float partialTick) {
            super.extractRenderState(entity, partialTick);
            renderState.setPartialTick(partialTick);
            renderState.setAnimationTick(TickUtils.animationTick());
        }

        private static ItemStack setItem(Object source, OpenEquipmentSlot slotType, ItemStack itemStack) {
            // set slot info render state.
            if (source instanceof HumanoidRenderState renderState) {
                return switch (slotType) {
                    case FEET -> {
                        var oldItemStack = renderState.feetEquipment;
                        renderState.feetEquipment = itemStack;
                        yield oldItemStack;
                    }
                    case LEGS -> {
                        var oldItemStack = renderState.legsEquipment;
                        renderState.legsEquipment = itemStack;
                        yield oldItemStack;
                    }
                    case CHEST -> {
                        var oldItemStack = renderState.chestEquipment;
                        renderState.chestEquipment = itemStack;
                        yield oldItemStack;
                    }
                    case HEAD -> {
                        var oldItemStack = renderState.headEquipment;
                        renderState.headEquipment = itemStack;
                        yield oldItemStack;
                    }
                    default -> itemStack;
                };
            }
            return itemStack;
        }
    }

    private static class BlockEntityImpl<T extends BlockEntity, S extends BlockEntityRenderState> extends AbstractImpl<T, S> {

        private final net.minecraft.client.renderer.blockentity.state.BlockEntityRenderState ref;

        private BlockEntityImpl(net.minecraft.client.renderer.blockentity.state.BlockEntityRenderState ref) {
            this.ref = ref;
        }

        @Override
        protected void extractRenderState(T entity, float partialTick) {
            super.extractRenderState(entity, partialTick);
            renderState.setPartialTick(partialTick);
            renderState.setAnimationTick(TickUtils.animationTick());
        }
    }
}
