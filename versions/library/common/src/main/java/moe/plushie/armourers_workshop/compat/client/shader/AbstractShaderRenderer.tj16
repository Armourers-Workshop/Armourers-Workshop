package moe.plushie.armourers_workshop.compat.client.shader;

import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.compat.client.AbstractColorBufferObject;
import moe.plushie.armourers_workshop.compat.client.AbstractLightBufferObject;
import moe.plushie.armourers_workshop.compat.client.AbstractModelViewStack;
import moe.plushie.armourers_workshop.core.client.shader.ShaderRenderer;
import moe.plushie.armourers_workshop.core.client.shader.ShaderContext;
import moe.plushie.armourers_workshop.core.client.shader.ShaderVertexObject;
import moe.plushie.armourers_workshop.utils.RenderSystem;
import org.lwjgl.opengl.GL15;

@Available("[1.16, 1.18)")
public class AbstractShaderRenderer implements ShaderRenderer {

    private static final AbstractShaderRenderer INSTANCE = new AbstractShaderRenderer();

    private final AbstractModelViewStack modelViewStack = AbstractModelViewStack.getInstance();

    public static AbstractShaderRenderer newInstance() {
        return INSTANCE;
    }

    @Override
    public void draw(ShaderVertexObject object, ShaderContext context) {
        var count = object.vertexCount();

        modelViewStack.pushMatrix();

        modelViewStack.last().multiply(object.pose().pose());

        object.bufferObject().bind();
        object.format().setupBufferState(object.vertexOffset());

        // when the outline color required, we need to modify the color attribute by `glColorPointer`.
        if (object.isOutline()) {
            var colorBuffer = AbstractColorBufferObject.getColorBuffer(object.outlineColor() | 0xff000000);
            colorBuffer.ensureCapacity(count);
            colorBuffer.bind();
            colorBuffer.format().setupBufferState(0L);
            object.bufferObject().bind();
        }

        // when the outline color required, we need to modify the lightmap texture attribute by `glVertexAttribPointer`.
        if (!object.isEmissive()) {
            var lightBuffer = AbstractLightBufferObject.getLightBuffer(object.lightmap());
            lightBuffer.ensureCapacity(count);
            lightBuffer.bind();
            lightBuffer.format().setupBufferState(0L);
            object.bufferObject().bind();
        }

        var indexObject = object.indexObject();
        if (indexObject != null) {
            indexObject.bind();
            GL15.glDrawElements(GL15.GL_TRIANGLES, indexObject.stride(count), indexObject.type(), 0);
        } else {
            GL15.glDrawArrays(GL15.GL_TRIANGLES, 0, count);
        }

        object.format().clearBufferState();

        modelViewStack.popMatrix();
    }
}
