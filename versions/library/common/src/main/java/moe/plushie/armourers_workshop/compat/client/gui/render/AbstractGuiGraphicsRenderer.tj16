package moe.plushie.armourers_workshop.compat.client.gui.render;

import com.apple.library.coregraphics.CGGraphicsContext;
import com.apple.library.coregraphics.CGGraphicsElement;
import com.apple.library.coregraphics.CGGraphicsParameters;
import com.apple.library.coregraphics.CGGraphicsRenderer;
import com.apple.library.coregraphics.CGGraphicsState;
import com.mojang.blaze3d.vertex.PoseStack;
import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.api.annotation.Dist;
import moe.plushie.armourers_workshop.api.annotation.OnlyIn;
import moe.plushie.armourers_workshop.api.client.IBufferSource;
import moe.plushie.armourers_workshop.api.client.IGraphicsContext;
import moe.plushie.armourers_workshop.api.client.IGraphicsElement;
import moe.plushie.armourers_workshop.compat.client.AbstractBufferSource;
import moe.plushie.armourers_workshop.compat.client.AbstractPoseStack;
import moe.plushie.armourers_workshop.compat.client.gui.AbstractMenuScreenImpl;
import moe.plushie.armourers_workshop.compat.client.renderer.AbstractGraphicsRenderer;
import moe.plushie.armourers_workshop.core.client.gui.element.StateGuiElement;
import moe.plushie.armourers_workshop.core.utils.LazyValue;

import java.util.function.BiConsumer;
import java.util.function.Consumer;

@Available("[1.16, 1.20)")
@OnlyIn(Dist.CLIENT)
public class AbstractGuiGraphicsRenderer implements CGGraphicsRenderer {

    private final CGGraphicsState state;
    private final IBufferSource bufferSource;
    private final LazyValue<IGraphicsContext> context;

    private AbstractGuiGraphicsRenderer(PoseStack poseStack) {
        this.state = new CGGraphicsState(AbstractPoseStack.wrap(poseStack));
        this.bufferSource = AbstractBufferSource.shared();
        this.context = new LazyValue<>(() -> AbstractGraphicsRenderer.wrap(poseStack, AbstractBufferSource.unwrap(bufferSource)));
    }

    public static void wrap(AbstractMenuScreenImpl<?> screen, PoseStack poseStack, float width, float height, float mouseX, float mouseY, float partialTicks, Consumer<CGGraphicsContext> action) {
        var param = new Context(screen, poseStack, width, height, mouseX, mouseY, partialTicks);
        var renderer = new AbstractGuiGraphicsRenderer(poseStack);
        var context = new CGGraphicsContext(renderer.state, param, renderer);
        context.draw(StateGuiElement.beginComposeLayer("main"));
        action.accept(context);
        context.draw(StateGuiElement.endComposeLayer("main"));
        context.flush();
    }

    public static void unwrap(CGGraphicsContext context, String name, BiConsumer<AbstractMenuScreenImpl<?>, PoseStack> action) {
        var param = (Context) context.param();
        context.draw(StateGuiElement.beginComposeLayer(name));
        action.accept(param.screen, param.poseStack);
        context.draw(StateGuiElement.endComposeLayer(name));
    }

    @Override
    public void render(CGGraphicsElement element) {
        // apply the flush into gui graphics.
        if (element instanceof StateGuiElement.Flush) {
            bufferSource.endBatch();
            return;
        }
        // forwarding the game element into game graphics.
        if (element instanceof IGraphicsElement element1) {
            context.get().draw(element1);
            return;
        }
        element.render(state.ctm(), bufferSource);
    }

    private static class Context extends CGGraphicsParameters {

        private final AbstractMenuScreenImpl<?> screen;
        private final PoseStack poseStack;

        public Context(AbstractMenuScreenImpl<?> screen, PoseStack poseStack, float width, float height, float mouseX, float mouseY, float partialTicks) {
            super(width, height, mouseX, mouseY, partialTicks, screen);
            this.screen = screen;
            this.poseStack = poseStack;
        }
    }
}
