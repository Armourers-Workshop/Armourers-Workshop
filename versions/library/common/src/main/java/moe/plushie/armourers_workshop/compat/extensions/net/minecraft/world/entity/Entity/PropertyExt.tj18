package moe.plushie.armourers_workshop.compat.extensions.net.minecraft.world.entity.Entity;

import moe.plushie.armourers_workshop.api.annotation.Available;
import net.minecraft.world.entity.Entity;
import net.minecraft.world.level.Level;

import manifold.ext.rt.api.Extension;
import manifold.ext.rt.api.This;

@Available("[18, 20)")
@Extension
public class PropertyExt {

    public static void setLevel(@This Entity entity, Level level) {
        entity.level = level;
    }

    public static Level level(@This Entity entity) {
        return entity.getLevel();
    }
}

