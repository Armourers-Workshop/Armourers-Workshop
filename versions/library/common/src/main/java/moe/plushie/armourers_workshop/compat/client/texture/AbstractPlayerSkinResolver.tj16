package moe.plushie.armourers_workshop.compat.client.texture;

import com.mojang.authlib.minecraft.MinecraftProfileTexture;
import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.api.core.IResultHandler;
import moe.plushie.armourers_workshop.compat.client.utils.AbstractGameProfile;
import moe.plushie.armourers_workshop.compat.core.AbstractResourceLocation;
import moe.plushie.armourers_workshop.core.skin.texture.PlayerSkin;
import moe.plushie.armourers_workshop.core.skin.texture.PlayerSkinDescriptor;
import moe.plushie.armourers_workshop.core.skin.texture.PlayerSkinModel;
import moe.plushie.armourers_workshop.core.skin.texture.PlayerSkinPart;
import moe.plushie.armourers_workshop.core.utils.Objects;
import moe.plushie.armourers_workshop.core.utils.OpenGameProfile;
import net.minecraft.client.Minecraft;
import net.minecraft.client.resources.DefaultPlayerSkin;
import net.minecraft.resources.ResourceLocation;

@Available("[1.16, 1.21)")
public class AbstractPlayerSkinResolver {

    public void resolve(OpenGameProfile profile, IResultHandler<PlayerSkin> handler) {
        // when this is a unknown user, it only call back a placeholder result.
        if (!profile.isResolvable()) {
            var texture = DefaultPlayerSkin.getDefaultSkin(profile.id());
            var modelName = DefaultPlayerSkin.getSkinModelName(profile.id());
            handler.accept(create(profile, texture, null, modelName));
            return;
        }
        var profile1 = AbstractGameProfile.unwrap(profile);
        Minecraft.getInstance().getSkinManager().registerSkins(profile1, (type, texture, profile2) -> {
            // the callback maybe call three times: skin/cape/elytra.
            if (type != MinecraftProfileTexture.Type.SKIN) {
                return; // ignore all except file of the skin
            }
            var textureUrl = profile2.getUrl();
            var modelName = profile2.getMetadata("model");
            handler.accept(create(profile, texture, textureUrl, modelName));
        }, false);
    }

    private PlayerSkin create(OpenGameProfile profile, ResourceLocation texture, String url, String modelName) {
        var body = new PlayerSkinPart(AbstractResourceLocation.wrap(texture), url);
        var descriptor = PlayerSkinDescriptor.fromProfile(profile);
        var model = PlayerSkinModel.WIDE;
        if (Objects.equals(modelName, "slim")) {
            model = PlayerSkinModel.SLIM;
        }
        return new PlayerSkin(descriptor, body, null, null, model);
    }
}


