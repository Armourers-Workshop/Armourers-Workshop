package moe.plushie.armourers_workshop.compat.client.renderer.vertex;

import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.api.client.IVertexFormat;
import moe.plushie.armourers_workshop.core.utils.FastMapper;
import org.lwjgl.opengl.GL11;

@Available("[16, 18)")
public abstract class AbstractVertexFormatImpl implements IVertexFormat {

    protected static final FastMapper<Mode, Integer> MODE_MAPPER = FastMapper.builder(Mode.QUADS, GL11.GL_QUADS, it -> {
        it.put(Mode.LINES, GL11.GL_LINE);
        it.put(Mode.DEBUG_LINES, GL11.GL_LINE);
        it.put(Mode.DEBUG_LINE_STRIP, GL11.GL_LINE_STRIP);
        it.put(Mode.TRIANGLES, GL11.GL_TRIANGLES);
        it.put(Mode.TRIANGLE_STRIP, GL11.GL_TRIANGLE_STRIP);
        it.put(Mode.TRIANGLE_FAN, GL11.GL_TRIANGLE_FAN);
        it.put(Mode.QUADS, GL11.GL_QUADS);
    });

    public static IVertexFormat.Mode wrap(int mode) {
        return MODE_MAPPER.getKey(mode);
    }
}
