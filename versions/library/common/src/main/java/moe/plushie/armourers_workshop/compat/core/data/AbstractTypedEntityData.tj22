package moe.plushie.armourers_workshop.compat.core.data;

import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.api.core.IDataCodec;
import moe.plushie.armourers_workshop.core.utils.Objects;
import moe.plushie.armourers_workshop.core.utils.TypedRegistry;
import moe.plushie.armourers_workshop.init.registry.Registries;
import net.minecraft.core.component.DataComponentType;
import net.minecraft.core.registries.BuiltInRegistries;
import net.minecraft.nbt.CompoundTag;
import net.minecraft.world.entity.EntityType;
import net.minecraft.world.item.component.TypedEntityData;

@Available("[1.22, )")
public class AbstractTypedEntityData<T> extends moe.plushie.armourers_workshop.core.data.TypedEntityData<T> {

    protected final TypedEntityData<?> impl;

    public AbstractTypedEntityData(Object type, CompoundTag tag) {
        this.impl = TypedEntityData.of(type, tag);
    }

    public AbstractTypedEntityData(TypedEntityData<?> impl) {
        this.impl = impl;
    }

    public static <T> IDataCodec<AbstractTypedEntityData<?>> createRegistryCodec(TypedRegistry<T> registry) {
        IDataCodec<TypedEntityData<?>> codec = Objects.unsafeCast(findRegistryCodec(registry));
        return codec.xmap(AbstractTypedEntityData::new, AbstractTypedEntityData::get);
    }

    @Override
    public CompoundTag tag() {
        return impl.getUnsafe();
    }

    public TypedEntityData<?> get() {
        return impl;
    }

    private static IDataCodec<?> findRegistryCodec(TypedRegistry<?> registry) {
        if (registry == Registries.ENTITY_TYPES) {
            return IDataCodec.wrap(TypedEntityData.codec(EntityType.CODEC));
        }
        if (registry == Registries.BLOCK_ENTITY_TYPES) {
            return IDataCodec.wrap(TypedEntityData.codec(BuiltInRegistries.BLOCK_ENTITY_TYPE.byNameCodec()));
        }
        throw new RuntimeException("not supported registry!!!");
    }

    public interface Serializer<S, R> {

        DataComponentType<R> key();

        default R encode(S value) {
            if (value instanceof AbstractTypedEntityData<?> data) {
                return Objects.unsafeCast(data.get());
            }
            return null;
        }

        default S decode(R value) {
            if (value instanceof TypedEntityData<?> impl) {
                return Objects.unsafeCast(new AbstractTypedEntityData<>(impl));
            }
            return null;
        }
    }
}
