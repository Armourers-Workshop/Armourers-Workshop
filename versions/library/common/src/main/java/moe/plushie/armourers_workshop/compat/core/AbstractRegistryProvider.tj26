package moe.plushie.armourers_workshop.compat.core;

import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.init.environment.EnvironmentExecutor;
import moe.plushie.armourers_workshop.init.platform.EnvironmentManager;
import net.minecraft.client.Minecraft;
import net.minecraft.core.Holder;
import net.minecraft.core.Registry;
import net.minecraft.core.RegistryAccess;
import net.minecraft.resources.ResourceKey;
import net.minecraft.resources.ResourceLocation;
import org.jetbrains.annotations.Nullable;

import java.util.Optional;

@Available("[1.26, )")
public class AbstractRegistryProvider<T> {

    @Nullable
    private final Registry<T> registry;

    private AbstractRegistryProvider(@Nullable Registry<T> registry) {
        this.registry = registry;
    }

    public static <T> AbstractRegistryProvider<T> from(ResourceKey<? extends Registry<? extends T>> registryKey) {
        // find registry access on the server.
        var server = EnvironmentManager.getServer();
        if (server != null) {
            return from(server.registryAccess(), registryKey);
        }
        // find registry access on the client.
        var client = EnvironmentExecutor.callOnClient(() -> () -> {
            var connection = Minecraft.getInstance().getConnection();
            if (connection != null) {
                return from(connection.registryAccess(), registryKey);
            }
            return null;
        });
        return client.orElse(null);
    }

    public static <T> AbstractRegistryProvider<T> from(RegistryAccess registryAccess, ResourceKey<? extends Registry<? extends T>> registryKey) {
        return new AbstractRegistryProvider<>(registryAccess.lookup(registryKey).orElse(null));
    }

    public Optional<? extends Holder<T>> get(ResourceLocation rl) {
        if (registry != null) {
            return registry.get(rl);
        }
        return Optional.empty();
    }
}
