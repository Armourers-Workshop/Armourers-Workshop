package moe.plushie.armourers_workshop.compat.mixin.patch.shader;

import com.llamalad7.mixinextras.injector.wrapoperation.Operation;
import com.llamalad7.mixinextras.injector.wrapoperation.WrapOperation;
import com.mojang.blaze3d.preprocessor.GlslPreprocessor;
import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.compat.client.AbstractClientHooks;
import moe.plushie.armourers_workshop.compat.client.shader.AbstractShaderSelector;
import moe.plushie.armourers_workshop.core.client.shader.ShaderPreprocessor;
import net.minecraft.client.renderer.ShaderManager;
import net.minecraft.resources.ResourceLocation;
import org.spongepowered.asm.mixin.Mixin;
import org.spongepowered.asm.mixin.injection.At;

import java.util.List;

@Available("[1.22, )")
@Mixin(ShaderManager.class)
public abstract class ShaderVanillaMixin {

    @WrapOperation(method = "loadShader", at = @At(value = "INVOKE", target = "Lcom/mojang/blaze3d/preprocessor/GlslPreprocessor;process(Ljava/lang/String;)Ljava/util/List;"))
    private static List<String> aw2$createVanillaShader(GlslPreprocessor instance, String source, Operation<List<String>> original, ResourceLocation location) {
        AbstractClientHooks.createShaders();
        // this is a vanilla shader resource.
        if (AbstractShaderSelector.DEFAULT.contains(location)) {
            var processor = new ShaderPreprocessor("vanilla", 3);
            source = processor.process(source);
        }
        return original.call(instance, source);
    }
}
