package moe.plushie.armourers_workshop.compat.mixin;

import com.mojang.blaze3d.platform.NativeImage;
import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.compat.client.AbstractNativeImage;
import moe.plushie.armourers_workshop.compat.client.AbstractRemoteTextureData;
import net.minecraft.client.renderer.texture.SkinTextureDownloader;
import net.minecraft.core.ClientAsset;
import net.minecraft.resources.ResourceLocation;
import org.spongepowered.asm.mixin.Mixin;
import org.spongepowered.asm.mixin.injection.At;
import org.spongepowered.asm.mixin.injection.Inject;
import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;

import java.nio.file.Path;
import java.util.HashMap;
import java.util.concurrent.CompletableFuture;

@Available("[1.22, )")
@Mixin(SkinTextureDownloader.class)
public class SkinTextureDownloaderMixin {

    private static HashMap<ResourceLocation, AbstractRemoteTextureData> ID_TO_DATAS = new HashMap<>();
    private static HashMap<String, AbstractRemoteTextureData> URL_TO_DATAS = new HashMap<>();

    @Inject(method = "downloadAndRegisterSkin", at = @At(value = "HEAD"))
    private static void aw2$downloadAndRegisterSkin(ResourceLocation location, Path filePath, String url, boolean bl, CallbackInfoReturnable<CompletableFuture<ResourceLocation>> cir) {
        var textureData = new AbstractRemoteTextureData(url);
        ID_TO_DATAS.put(location, textureData);
        URL_TO_DATAS.put(url, textureData);
    }

    @Inject(method = "processLegacySkin", at = @At(value = "HEAD"))
    private static void aw2$processLegacySkin(NativeImage image, String url, CallbackInfoReturnable<NativeImage> cir) {
        var slimModel = false;
        if (image != null && image.getWidth() > 54 && image.getHeight() > 20) {
            slimModel = (image.getPixelRGBA(54, 20) & 0xff000000) == 0;
        }
        var textureData = URL_TO_DATAS.get(url);
        if (textureData != null) {
            textureData.setSlimModel(slimModel);
        }
    }

    @Inject(method = "registerTextureInManager", at = @At(value = "HEAD"))
    private static void aw2$registerTextureInManager(ClientAsset.Texture texture, NativeImage image, CallbackInfoReturnable<CompletableFuture<ClientAsset.Texture>> cir) {
        var textureData = ID_TO_DATAS.remove(texture.texturePath());
        if (textureData != null) {
            textureData.setData(AbstractNativeImage.of(image));
            URL_TO_DATAS.remove(textureData.url());
        }
    }
}
