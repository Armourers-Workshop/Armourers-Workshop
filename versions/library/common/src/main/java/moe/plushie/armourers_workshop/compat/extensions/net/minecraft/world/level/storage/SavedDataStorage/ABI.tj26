package moe.plushie.armourers_workshop.compat.extensions.net.minecraft.world.level.storage.SavedDataStorage;

import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.compat.core.data.AbstractSavedData;
import moe.plushie.armourers_workshop.compat.core.data.AbstractSavedDataType;
import net.minecraft.world.level.storage.SavedDataStorage;
import org.jetbrains.annotations.Nullable;

import manifold.ext.rt.api.Extension;
import manifold.ext.rt.api.This;

@Available("[26, )")
@Extension
public class ABI {

    public static <T extends AbstractSavedData> T computeIfAbsent(@This SavedDataStorage storage, AbstractSavedDataType<T> type) {
        return type.computeIfAbsent(storage);
    }

    @Nullable
    public static <T extends AbstractSavedData> T get(@This SavedDataStorage storage, AbstractSavedDataType<T> type) {
        return type.get(storage);
    }
}
