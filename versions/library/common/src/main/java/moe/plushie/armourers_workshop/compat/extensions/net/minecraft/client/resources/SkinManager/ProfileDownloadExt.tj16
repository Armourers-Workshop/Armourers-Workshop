package moe.plushie.armourers_workshop.compat.extensions.net.minecraft.client.resources.SkinManager;

import com.mojang.authlib.GameProfile;
import com.mojang.authlib.minecraft.MinecraftProfileTexture;
import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.core.client.texture.EntityTextureDownloader;
import moe.plushie.armourers_workshop.core.utils.OpenResourceLocation;
import net.minecraft.client.Minecraft;
import net.minecraft.client.resources.DefaultPlayerSkin;
import net.minecraft.client.resources.SkinManager;

import manifold.ext.rt.api.Extension;
import manifold.ext.rt.api.This;

@Available("[1.16, 1.21)")
@Extension
public class ProfileDownloadExt {

    public static void downloadAndRegisterSkin(@This SkinManager manager, GameProfile profile, EntityTextureDownloader.Callback callback) {
        // when this is a unknown user, it only call back a placeholder result.
        if (profile.getProperties().isEmpty()) {
            var texture = DefaultPlayerSkin.getDefaultSkin(profile.getId());
            var location = OpenResourceLocation.of(texture);
            var modelType = DefaultPlayerSkin.getSkinModelName(profile.getId());
            callback.apply(location, null, modelType);
            return;
        }
        Minecraft.getInstance().getSkinManager().registerSkins(profile, (type, texture, profile1) -> {
            // the callback maybe call three times: skin/cape/elytra.
            if (type != MinecraftProfileTexture.Type.SKIN) {
                return; // ignore all except file of the skin
            }
            var location = OpenResourceLocation.of(texture);
            var url = profile1.getUrl();
            var modelType = profile1.getMetadata("model");
            callback.apply(location, url, modelType);
        }, false);
    }
}
