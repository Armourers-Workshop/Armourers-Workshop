package moe.plushie.armourers_workshop.compat.extensions.net.minecraft.client.Minecraft;

import moe.plushie.armourers_workshop.api.annotation.Available;
import net.minecraft.client.Minecraft;
import net.minecraft.client.renderer.item.ItemModel;
import net.minecraft.core.component.DataComponents;
import net.minecraft.world.entity.LivingEntity;
import net.minecraft.world.item.ItemStack;
import net.minecraft.world.level.Level;
import org.jetbrains.annotations.Nullable;

import manifold.ext.rt.api.Extension;
import manifold.ext.rt.api.This;

@Available("[1.22,)")
@Extension
public class ItemModelExt {

    public static ItemModel getItemModel(@This Minecraft minecraft, ItemStack itemStack, @Nullable Level level, @Nullable LivingEntity entity, int flags) {
        // referenced: ItemModelResolver.appendItemLayers
        var location = itemStack.get(DataComponents.ITEM_MODEL);
        if (location != null) {
            return minecraft.getModelManager().getItemModel(location);
        }
        return null;
    }
}
