package moe.plushie.armourers_workshop.compatibility.client;

import com.mojang.blaze3d.vertex.VertexFormat;
import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.api.client.IVertexFormat;
import moe.plushie.armourers_workshop.core.utils.Collections;
import net.fabricmc.api.EnvType;
import net.fabricmc.api.Environment;
import org.lwjgl.opengl.GL11;

import java.util.Map;

@Available("[1.16, 1.18)")
@Environment(EnvType.CLIENT)
public class AbstractVertexFormat implements IVertexFormat {

    private static final Map<Integer, Mode> MAPPER = Collections.immutableMap(it -> {
        it.put(GL11.GL_LINE, Mode.LINES);
        it.put(GL11.GL_LINE_STRIP, Mode.LINE_STRIP);
        //it.put(GL11.GL_LINE, Mode.DEBUG_LINES);
        //it.put(GL11.GL_LINE_STRIP, Mode.DEBUG_LINE_STRIP);
        it.put(GL11.GL_TRIANGLES, Mode.TRIANGLES);
        it.put(GL11.GL_TRIANGLE_STRIP, Mode.TRIANGLE_STRIP);
        it.put(GL11.GL_TRIANGLE_FAN, Mode.TRIANGLE_FAN);
        it.put(GL11.GL_QUADS, Mode.QUADS);
    });

    private final VertexFormat impl;

    private AbstractVertexFormat(VertexFormat impl) {
        this.impl = impl;
    }

    public static IVertexFormat of(VertexFormat format) {
        return new AbstractVertexFormat(format);
    }

    public static Mode of(int mode) {
        return MAPPER.getOrDefault(mode, Mode.QUADS);
    }

    @Override
    public void setupBufferState(long offset) {
        impl.setupBufferState(offset);
    }

    @Override
    public void clearBufferState() {
        impl.clearBufferState();
    }

    @Override
    public int vertexSize() {
        return impl.getVertexSize();
    }

    @Override
    public VertexFormat get() {
        return impl;
    }
}
