package moe.plushie.armourers_workshop.compat.client.renderer.model;

import com.mojang.blaze3d.vertex.PoseStack;
import com.mojang.blaze3d.vertex.VertexConsumer;
import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.api.annotation.Dist;
import moe.plushie.armourers_workshop.api.annotation.OnlyIn;
import moe.plushie.armourers_workshop.api.annotation.Patch;
import moe.plushie.armourers_workshop.compat.client.renderer.AbstractHumanoidEntityRenderer;
import net.minecraft.client.model.HumanoidModel;
import net.minecraft.client.model.geom.ModelLayerLocation;
import net.minecraft.client.model.geom.ModelLayers;
import net.minecraft.client.model.geom.ModelPart;
import net.minecraft.client.renderer.entity.EntityRendererProvider;
import net.minecraft.client.renderer.entity.state.HumanoidRenderState;
import net.minecraft.world.entity.LivingEntity;

@Available("[1.22, )")
@OnlyIn(Dist.CLIENT)
public class AbstractHumanoidModelImpl<T extends LivingEntity, S extends HumanoidRenderState> extends HumanoidModel<S> {

    public final ModelPart leftSleeve;
    public final ModelPart rightSleeve;
    public final ModelPart leftPants;
    public final ModelPart rightPants;
    public final ModelPart jacket;

    public AbstractHumanoidModelImpl(Context context) {
        super(context.part());
        // copy from the PlayerModel
        this.leftSleeve = leftArm.getChild("left_sleeve");
        this.rightSleeve = rightArm.getChild("right_sleeve");
        this.leftPants = leftLeg.getChild("left_pants");
        this.rightPants = rightLeg.getChild("right_pants");
        this.jacket = body.getChild("jacket");
    }

    public static Context getEmptyContext() {
        return Context.create(AbstractHumanoidEntityRenderer.getEmptyContext(), ModelLayers.PLAYER);
    }

    @Patch("called in mixin - 1.22")
    public void translateAndRotate(PoseStack poseStack) {
        // nop.
    }

    public interface Context {

        ModelPart part();

        static Context create(EntityRendererProvider.Context context, ModelLayerLocation id) {
            return () -> context.bakeLayer(id);
        }
    }
}
