package moe.plushie.armourers_workshop.compat.client.gui.event;

import moe.plushie.armourers_workshop.api.annotation.Available;
import net.minecraft.client.input.MouseButtonEvent;

@Available("[26, )")
public class AbstractMouseButtonEvent extends AbstractMouseEvent {

    public final MouseButtonEvent event;

    public AbstractMouseButtonEvent(MouseButtonEvent event) {
        super(event.x(), event.y());
        this.event = event;
    }

    @Override
    public int button() {
        return event.button();
    }
}
