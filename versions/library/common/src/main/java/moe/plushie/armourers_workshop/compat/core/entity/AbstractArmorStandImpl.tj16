package moe.plushie.armourers_workshop.compat.core.entity;

import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.api.annotation.Export;
import moe.plushie.armourers_workshop.api.common.IEntityDataBuilder;
import moe.plushie.armourers_workshop.api.core.IDataSerializer;
import moe.plushie.armourers_workshop.compat.core.AbstractInteractionHand;
import moe.plushie.armourers_workshop.compat.core.AbstractInteractionResult;
import moe.plushie.armourers_workshop.compat.core.data.serializer.AbstractDataSerializer;
import moe.plushie.armourers_workshop.core.utils.OpenInteractionHand;
import moe.plushie.armourers_workshop.core.utils.OpenInteractionResult;
import net.minecraft.nbt.CompoundTag;
import net.minecraft.server.level.ServerLevel;
import net.minecraft.world.InteractionHand;
import net.minecraft.world.InteractionResult;
import net.minecraft.world.damagesource.DamageSource;
import net.minecraft.world.entity.Entity;
import net.minecraft.world.entity.EntityDimensions;
import net.minecraft.world.entity.EntityType;
import net.minecraft.world.entity.Pose;
import net.minecraft.world.entity.decoration.ArmorStand;
import net.minecraft.world.entity.player.Player;
import net.minecraft.world.level.Level;
import net.minecraft.world.phys.Vec3;
import org.jetbrains.annotations.Nullable;

@Available("[1.16, 1.21)")
public class AbstractArmorStandImpl extends ArmorStand {

    public AbstractArmorStandImpl(EntityType<? extends ArmorStand> entityType, Level level) {
        super(entityType, level);
    }

    public OpenInteractionResult interactAt(Player player, Vec3 pos, OpenInteractionHand hand, Object context) {
        return AbstractInteractionResult.wrap(super.interactAt(player, pos, AbstractInteractionHand.unwrap(hand)));
    }

    @Override
    public final InteractionResult interactAt(Player player, Vec3 vec3, InteractionHand hand) {
        return AbstractInteractionResult.unwrap(interactAt(player, vec3, AbstractInteractionHand.wrap(hand), null));
    }

    public boolean hurt(ServerLevel level, DamageSource source, float amount) {
        return super.hurt(source, amount);
    }

    @Override
    public final boolean hurt(DamageSource damageSource, float f) {
        if (level() instanceof ServerLevel level) {
            return hurt(level, damageSource, f);
        }
        return super.hurt(damageSource, f);
    }

    public void readAdditionalSaveData(IDataSerializer serializer) {
        super.readAdditionalSaveData(AbstractDataSerializer.unwrap(serializer));
    }

    @Override
    public final void readAdditionalSaveData(CompoundTag tag) {
        readAdditionalSaveData(AbstractDataSerializer.wrap(tag, this));
    }

    public void addAdditionalSaveData(IDataSerializer serializer) {
        super.addAdditionalSaveData(AbstractDataSerializer.unwrap(serializer));
    }

    @Override
    public final void addAdditionalSaveData(CompoundTag tag) {
        addAdditionalSaveData(AbstractDataSerializer.wrap(tag, this));
    }

    public void defineSynchedData(IEntityDataBuilder builder) {
        super.defineSynchedData();
    }

    @Override
    protected void defineSynchedData() {
        defineSynchedData(AbstractEntityDataBuilder.wrap(entityData));
    }

    public void kill(ServerLevel level) {
        super.kill();
    }

    @Override
    public final void kill() {
        if (level() instanceof ServerLevel level) {
            kill(level);
        }
    }

    public void dropEquipment(ServerLevel level) {
        super.dropEquipment();
    }

    @Override
    protected final void dropEquipment() {
        if (level() instanceof ServerLevel level) {
            dropEquipment(level);
        }
    }

    public void brokenByPlayer(ServerLevel level, DamageSource damageSource, Object context) {
        super.brokenByPlayer(damageSource);
    }

    @Override
    public final void brokenByPlayer(DamageSource damageSource) {
        if (level() instanceof ServerLevel level) {
            brokenByPlayer(level, damageSource, null);
        }
    }

    public void brokenByAnything(ServerLevel level, DamageSource damageSource, Object context) {
        super.brokenByAnything(damageSource);
    }

    @Override
    public final void brokenByAnything(DamageSource damageSource) {
        if (level() instanceof ServerLevel level) {
            brokenByAnything(level, damageSource, null);
        }
    }

    public boolean canBeCollidedWith(@Nullable Entity entity) {
        return super.canBeCollidedWith();
    }

    @Override
    public final boolean canBeCollidedWith() {
        return canBeCollidedWith(null);
    }

    public float sanitizeScale(float f) {
        return super.getScale();
    }

    @Override
    public final float getScale() {
        return sanitizeScale(1.0f);
    }

    @Export("dummy")
    public float getYBodyRot() {
        return yBodyRot;
    }

    public EntityDimensions getDefaultDimensions(Pose pose) {
        return super.getDimensions(pose);
    }

    @Override
    public final EntityDimensions getDimensions(Pose pose) {
        return getDefaultDimensions(pose).scale(getScale());
    }

    @Override
    protected final float getStandingEyeHeight(Pose pose, EntityDimensions entityDimensions) {
        var dimensions = getDefaultDimensions(pose);
        return dimensions.getEyeHeight() * getScale();
    }

    public final void snapTo(double x, double y, double z, float yRot, float xRot) {
        moveTo(x, y, z, yRot, xRot);
    }

    public final void snapTo(double x, double y, double z) {
        moveTo(x, y, z);
    }
}
