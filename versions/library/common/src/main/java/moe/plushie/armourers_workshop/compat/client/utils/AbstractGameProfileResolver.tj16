package moe.plushie.armourers_workshop.compat.client.utils;

import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.api.core.IResultHandler;
import moe.plushie.armourers_workshop.core.utils.OpenGameProfile;
import net.minecraft.world.level.block.entity.SkullBlockEntity;

@Available("[16, 18)")
public class AbstractGameProfileResolver {

    public void resolve(OpenGameProfile profile, IResultHandler<OpenGameProfile> handler) {
        try {
            // when properties is empty, we will assume the user can't found.
            var profile1 = SkullBlockEntity.updateGameprofile(AbstractGameProfile.unwrap(profile));
            if (profile1 != null) {
                handler.accept(AbstractGameProfile.wrap(profile1));
            } else {
                handler.accept(profile);
            }
        } catch (Exception exception) {
            handler.abort(exception); // we called mojang API, it will throw `com.mojang.authlib.exceptions.*`.
        }
    }
}
