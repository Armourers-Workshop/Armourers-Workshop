package moe.plushie.armourers_workshop.compat.core;

import moe.plushie.armourers_workshop.api.annotation.Available;
import net.minecraft.network.chat.ClickEvent;

import java.net.URI;

@Available("[1.26, )")
public class AbstractOpenURLEvent implements ClickEvent {

    private final ClickEvent.OpenUrl impl;

    public AbstractOpenURLEvent(String url) {
        this.impl = new OpenUrl(URI.create(url));
    }

    @Override
    public Action action() {
        return impl.action();
    }

    public URI uri() {
        return impl.uri();
    }
}
