package moe.plushie.armourers_workshop.compat.client.item.tintsource;

import com.mojang.serialization.MapCodec;
import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.api.client.IItemTintSource;
import moe.plushie.armourers_workshop.api.client.IItemTintSourceType;
import net.minecraft.client.color.item.ItemTintSource;
import net.minecraft.client.multiplayer.ClientLevel;
import net.minecraft.world.entity.LivingEntity;
import net.minecraft.world.item.ItemStack;
import org.jetbrains.annotations.Nullable;

@Available("[1.26, )")
public abstract class AbstractItemTintSourceImpl {


    public static <T extends IItemTintSource> MapCodec<? extends ItemTintSource> getCodec(IItemTintSourceType<T> type) {
        return Wrapper.wrap(type.codec().mapCodec());
    }

    private static class Wrapper<T extends IItemTintSource> implements ItemTintSource {

        private final T source;
        private final MapCodec<T> codec;

        private Wrapper(T source, MapCodec<T> codec) {
            this.source = source;
            this.codec = codec;
        }

        public static <T extends IItemTintSource> MapCodec<Wrapper<T>> wrap(MapCodec<T> codec) {
            return codec.xmap(it -> new Wrapper<>(it, codec), it -> it.source);
        }

        @Override
        public int calculate(ItemStack itemStack, @Nullable ClientLevel level, @Nullable LivingEntity entity) {
            return source.calculate(itemStack, level, entity);
        }

        @Override
        public MapCodec<Wrapper<T>> type() {
            return Wrapper.wrap(codec);
        }
    }
}
