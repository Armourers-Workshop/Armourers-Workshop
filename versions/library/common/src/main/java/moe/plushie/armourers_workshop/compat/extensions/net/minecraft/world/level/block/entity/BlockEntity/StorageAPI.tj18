package moe.plushie.armourers_workshop.compat.extensions.net.minecraft.world.level.block.entity.BlockEntity;

import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.core.utils.TagSerializer;
import net.minecraft.world.level.block.entity.BlockEntity;

import manifold.ext.rt.api.Extension;
import manifold.ext.rt.api.This;

@Extension
@Available("[18, 21)")
public class StorageAPI {

    public static void saveFullData(@This BlockEntity blockEntity, TagSerializer serializer) {
        var result = blockEntity.saveWithFullMetadata();
        if (!result.isEmpty()) {
            serializer.tag().merge(result);
        }
    }

    public static void loadFullData(@This BlockEntity blockEntity, TagSerializer serializer) {
        blockEntity.load(serializer.tag());
    }
}
