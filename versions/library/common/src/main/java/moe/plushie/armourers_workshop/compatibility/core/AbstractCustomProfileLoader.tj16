package moe.plushie.armourers_workshop.compatibility.core;

import com.mojang.authlib.GameProfile;
import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.api.core.IResultHandler;
import net.minecraft.world.level.block.entity.SkullBlockEntity;

@Available("[1.16, 1.18)")
public class AbstractCustomProfileLoader {

    public static void load(GameProfile profile, IResultHandler<GameProfile> handler) {
        try {
            // when properties is empty, we will assume the user can't found.
            var profile1 = SkullBlockEntity.updateGameprofile(profile);
            if (profile1 != null && profile1.getProperties() != null && !profile1.getProperties().isEmpty()) {
                handler.accept(profile1);
                return;
            }
            handler.abort(new RuntimeException("Not Found Game Profile: " + profile.getName()));
        } catch (Exception exception) {
            handler.abort(exception); // we called mojang API, it will throw `com.mojang.authlib.exceptions.*`.
        }
    }
}
