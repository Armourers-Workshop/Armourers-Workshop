package moe.plushie.armourers_workshop.compat.extensions.com.mojang.serialization.DataResult;

import com.mojang.serialization.DataResult;
import moe.plushie.armourers_workshop.api.annotation.Available;

import java.util.function.Consumer;

import manifold.ext.rt.api.Extension;
import manifold.ext.rt.api.This;

@Available("[16, 21)")
@Extension
public class ErrorStream {

    public static <R> DataResult<R> ifError(@This DataResult<R> result, Consumer<DataResult.PartialResult<R>> message) {
        result.error().ifPresent(message);
        return result;
    }
}
