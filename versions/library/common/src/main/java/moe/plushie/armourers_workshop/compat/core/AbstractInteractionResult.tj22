package moe.plushie.armourers_workshop.compat.core;

import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.core.utils.FastMapper;
import moe.plushie.armourers_workshop.core.utils.OpenInteractionResult;
import net.minecraft.world.InteractionResult;

@Available("[1.22, )")
public class AbstractInteractionResult {

    private static final FastMapper<OpenInteractionResult.SwingSource, InteractionResult.SwingSource> SOURCE_MAPPER = FastMapper.builder(OpenInteractionResult.SwingSource.NONE, InteractionResult.SwingSource.NONE, it -> {
        it.put(OpenInteractionResult.SwingSource.NONE, InteractionResult.SwingSource.NONE);
        it.put(OpenInteractionResult.SwingSource.CLIENT, InteractionResult.SwingSource.CLIENT);
        it.put(OpenInteractionResult.SwingSource.SERVER, InteractionResult.SwingSource.SERVER);
    });

    private static final FastMapper<OpenInteractionResult, InteractionResult> INTERACTION_RESULT_MAPPER = FastMapper.builder(it -> {
        it.put(OpenInteractionResult.SUCCESS, InteractionResult.SUCCESS);
        it.put(OpenInteractionResult.SUCCESS_SERVER, InteractionResult.SUCCESS_SERVER);
        it.put(OpenInteractionResult.CONSUME, InteractionResult.CONSUME);
        it.put(OpenInteractionResult.PASS, InteractionResult.PASS);
        it.put(OpenInteractionResult.FAIL, InteractionResult.FAIL);
        it.put(OpenInteractionResult.TRY_WITH_EMPTY_HAND, InteractionResult.TRY_WITH_EMPTY_HAND);
    });

    public static OpenInteractionResult wrap(InteractionResult result) {
        var result1 = INTERACTION_RESULT_MAPPER.getKey(result);
        if (result1 != null) {
            return result1;
        }
        if (result instanceof InteractionResult.Success result2) {
            return new OpenInteractionResult.Success(wrap(result2.swingSource()), wrap(result2.itemContext()));
        }
        return OpenInteractionResult.FAIL;
    }

    public static InteractionResult unwrap(OpenInteractionResult result) {
        var result1 = INTERACTION_RESULT_MAPPER.getValue(result);
        if (result1 != null) {
            return result1;
        }
        if (result instanceof OpenInteractionResult.Success result2) {
            return new InteractionResult.Success(unwrap(result2.swingSource()), unwrap(result2.itemContext()));
        }
        return InteractionResult.FAIL;
    }


    private static OpenInteractionResult.SwingSource wrap(InteractionResult.SwingSource source) {
        return SOURCE_MAPPER.getKey(source);
    }

    private static InteractionResult.SwingSource unwrap(OpenInteractionResult.SwingSource source) {
        return SOURCE_MAPPER.getValue(source);
    }

    private static OpenInteractionResult.ItemContext wrap(InteractionResult.ItemContext context) {
        return new OpenInteractionResult.ItemContext(context.wasItemInteraction(), context.heldItemTransformedTo());
    }

    private static InteractionResult.ItemContext unwrap(OpenInteractionResult.ItemContext context) {
        return new InteractionResult.ItemContext(context.wasItemInteraction(), context.heldItemTransformedTo());
    }
}
