package moe.plushie.armourers_workshop.compat.client.item;

import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.core.utils.FastMapper;
import moe.plushie.armourers_workshop.core.utils.OpenItemDisplayContext;
import net.minecraft.client.renderer.block.model.ItemTransforms;

@Available("[16, 20)")
public class AbstractItemDisplayContext {

    private static final FastMapper<OpenItemDisplayContext, ItemTransforms.TransformType> MAPPER = FastMapper.builder(OpenItemDisplayContext.NONE, ItemTransforms.TransformType.NONE, it -> {
        it.put(OpenItemDisplayContext.NONE, ItemTransforms.TransformType.NONE);
        it.put(OpenItemDisplayContext.THIRD_PERSON_LEFT_HAND, ItemTransforms.TransformType.THIRD_PERSON_LEFT_HAND);
        it.put(OpenItemDisplayContext.THIRD_PERSON_RIGHT_HAND, ItemTransforms.TransformType.THIRD_PERSON_RIGHT_HAND);
        it.put(OpenItemDisplayContext.FIRST_PERSON_LEFT_HAND, ItemTransforms.TransformType.FIRST_PERSON_LEFT_HAND);
        it.put(OpenItemDisplayContext.FIRST_PERSON_RIGHT_HAND, ItemTransforms.TransformType.FIRST_PERSON_RIGHT_HAND);
        it.put(OpenItemDisplayContext.HEAD, ItemTransforms.TransformType.HEAD);
        it.put(OpenItemDisplayContext.GROUND, ItemTransforms.TransformType.GROUND);
        it.put(OpenItemDisplayContext.GUI, ItemTransforms.TransformType.GUI);
        it.put(OpenItemDisplayContext.FIXED, ItemTransforms.TransformType.FIXED);
    });

    public static OpenItemDisplayContext wrap(ItemTransforms.TransformType transformType) {
        return MAPPER.getKey(transformType);
    }

    public static ItemTransforms.TransformType unwrap(OpenItemDisplayContext transformType) {
        return MAPPER.getValue(transformType);
    }
}
