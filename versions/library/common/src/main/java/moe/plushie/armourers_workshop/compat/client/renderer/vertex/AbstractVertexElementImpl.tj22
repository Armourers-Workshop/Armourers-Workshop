package moe.plushie.armourers_workshop.compat.client.renderer.vertex;

import com.mojang.blaze3d.opengl.GlConst;
import com.mojang.blaze3d.vertex.VertexFormatElement;
import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.api.client.IVertexElement;
import org.lwjgl.opengl.GL20;
import org.lwjgl.opengl.GL30;

@Available("[1.22, )")
public abstract class AbstractVertexElementImpl implements IVertexElement {

    @Override
    public void setupBufferState(int index, int stride, long pointer) {
        GL20.glEnableVertexAttribArray(index);
        var element = get();
        switch (element.usage()) {
            case POSITION:
            case GENERIC:
            case UV: {
                if (element.type() == VertexFormatElement.Type.FLOAT) {
                    GL20.glVertexAttribPointer(index, count(), glType(), false, stride, pointer);
                } else {
                    GL30.glVertexAttribIPointer(index, count(), glType(), stride, pointer);
                }
                break;
            }
            case NORMAL:
            case COLOR: {
                GL20.glVertexAttribPointer(index, count(), glType(), true, stride, pointer);
                break;
            }
        }
    }

    @Override
    public void clearBufferState(int index) {
        GL20.glDisableVertexAttribArray(index);
    }

    @Override
    public int byteSize() {
        return get().byteSize();
    }

    public int glType() {
        return GlConst.toGl(get().type());
    }

    public int count() {
        return get().count();
    }
}
