package moe.plushie.armourers_workshop.compat.client;

import com.mojang.blaze3d.pipeline.BlendFunction;
import com.mojang.blaze3d.pipeline.RenderPipeline;
import com.mojang.blaze3d.platform.DepthTestFunction;
import com.mojang.blaze3d.platform.LogicOp;
import com.mojang.blaze3d.platform.PolygonMode;
import com.mojang.blaze3d.vertex.DefaultVertexFormat;
import com.mojang.blaze3d.vertex.VertexFormat;
import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.api.client.IRenderType;
import moe.plushie.armourers_workshop.api.core.IResourceLocation;
import moe.plushie.armourers_workshop.core.client.other.SkinVertexFormat;
import moe.plushie.armourers_workshop.core.utils.Collections;
import moe.plushie.armourers_workshop.init.ModConstants;
import net.minecraft.client.renderer.RenderPipelines;
import net.minecraft.client.renderer.RenderStateShard;
import net.minecraft.client.renderer.RenderType;
import net.minecraft.resources.ResourceLocation;
import org.lwjgl.opengl.GL11;

import java.util.ArrayList;
import java.util.Map;
import java.util.Optional;
import java.util.OptionalDouble;
import java.util.function.Supplier;

@Available("[1.22, )")
public abstract class AbstractRenderTypeImpl extends RenderType {

    private static final Map<SkinVertexFormat, Supplier<Builder>> MAPPER = Collections.immutableMap(it -> {

        it.put(SkinVertexFormat.LINE, () -> _builder(DefaultVertexFormat.POSITION_COLOR, VertexFormat.Mode.DEBUG_LINES, RenderPipelines.GUI));
        it.put(SkinVertexFormat.LINE_STRIP, () -> _builder(DefaultVertexFormat.POSITION_COLOR, VertexFormat.Mode.DEBUG_LINE_STRIP, RenderPipelines.GUI));

        it.put(SkinVertexFormat.BLIT_MASK, () -> _builder(DefaultVertexFormat.POSITION_COLOR, VertexFormat.Mode.TRIANGLES, RenderPipelines.GUI_TEXTURED));
        it.put(SkinVertexFormat.BLIT_TEXTURED, () -> _builder(DefaultVertexFormat.POSITION_TEX_COLOR, VertexFormat.Mode.QUADS, RenderPipelines.GUI_TEXTURED));

        it.put(SkinVertexFormat.GUI_COLOR, () -> _builder(DefaultVertexFormat.POSITION_COLOR, VertexFormat.Mode.QUADS, RenderPipelines.GUI));
        it.put(SkinVertexFormat.GUI_TEXTURED, () -> _builder(DefaultVertexFormat.POSITION_TEX_COLOR, VertexFormat.Mode.QUADS, RenderPipelines.GUI_TEXTURED));

        it.put(SkinVertexFormat.BLOCK, () -> _builder(DefaultVertexFormat.NEW_ENTITY, VertexFormat.Mode.QUADS, RenderPipelines.ENTITY_SOLID));
        it.put(SkinVertexFormat.BLOCK_CUTOUT, () -> _builder(DefaultVertexFormat.NEW_ENTITY, VertexFormat.Mode.QUADS, RenderPipelines.ENTITY_CUTOUT));

        it.put(SkinVertexFormat.ENTITY_CUTOUT, () -> _builder(DefaultVertexFormat.NEW_ENTITY, VertexFormat.Mode.QUADS, RenderPipelines.ENTITY_CUTOUT));
        it.put(SkinVertexFormat.ENTITY_CUTOUT_NO_CULL, () -> _builder(DefaultVertexFormat.NEW_ENTITY, VertexFormat.Mode.QUADS, RenderPipelines.ENTITY_CUTOUT_NO_CULL));
        it.put(SkinVertexFormat.ENTITY_TRANSLUCENT, () -> _builder(DefaultVertexFormat.NEW_ENTITY, VertexFormat.Mode.QUADS, RenderPipelines.ENTITY_TRANSLUCENT));
        it.put(SkinVertexFormat.ENTITY_ALPHA, () -> _builder(DefaultVertexFormat.NEW_ENTITY, VertexFormat.Mode.QUADS, RenderPipelines.ENTITY_SHADOW));

        it.put(SkinVertexFormat.SKIN_BLOCK_FACE_SOLID, () -> _builder(DefaultVertexFormat.NEW_ENTITY, VertexFormat.Mode.QUADS, RenderPipelines.ENTITY_SOLID).overlay().lightmap());
        it.put(SkinVertexFormat.SKIN_BLOCK_FACE_LIGHTING, () -> _builder(DefaultVertexFormat.NEW_ENTITY, VertexFormat.Mode.QUADS, RenderPipelines.ENTITY_SHADOW).overlay().lightmap().emissive());
        it.put(SkinVertexFormat.SKIN_BLOCK_FACE_TRANSLUCENT, () -> _builder(DefaultVertexFormat.NEW_ENTITY, VertexFormat.Mode.QUADS, RenderPipelines.ENTITY_SOLID).overlay().lightmap());
        it.put(SkinVertexFormat.SKIN_BLOCK_FACE_LIGHTING_TRANSLUCENT, () -> _builder(DefaultVertexFormat.NEW_ENTITY, VertexFormat.Mode.QUADS, RenderPipelines.ENTITY_SHADOW).overlay().lightmap().emissive());

        it.put(SkinVertexFormat.SKIN_CUBE_FACE_SOLID, () -> _builder(DefaultVertexFormat.NEW_ENTITY, VertexFormat.Mode.QUADS, RenderPipelines.ENTITY_CUTOUT).overlay().lightmap());
        it.put(SkinVertexFormat.SKIN_CUBE_FACE_LIGHTING, () -> _builder(DefaultVertexFormat.NEW_ENTITY, VertexFormat.Mode.QUADS, RenderPipelines.ENERGY_SWIRL).overlay().lightmap().emissive());
        it.put(SkinVertexFormat.SKIN_CUBE_FACE_TRANSLUCENT, () -> _builder(DefaultVertexFormat.NEW_ENTITY, VertexFormat.Mode.QUADS, RenderPipelines.ENTITY_SOLID).overlay().lightmap());
        it.put(SkinVertexFormat.SKIN_CUBE_FACE_LIGHTING_TRANSLUCENT, () -> _builder(DefaultVertexFormat.NEW_ENTITY, VertexFormat.Mode.QUADS, RenderPipelines.ENERGY_SWIRL).overlay().lightmap().emissive());

        it.put(SkinVertexFormat.SKIN_MESH_FACE_SOLID, () -> _builder(DefaultVertexFormat.NEW_ENTITY, VertexFormat.Mode.TRIANGLES, RenderPipelines.ENTITY_CUTOUT).overlay().lightmap());
        it.put(SkinVertexFormat.SKIN_MESH_FACE_LIGHTING, () -> _builder(DefaultVertexFormat.NEW_ENTITY, VertexFormat.Mode.TRIANGLES, RenderPipelines.ENERGY_SWIRL).overlay().lightmap().emissive());
        it.put(SkinVertexFormat.SKIN_MESH_FACE_TRANSLUCENT, () -> _builder(DefaultVertexFormat.NEW_ENTITY, VertexFormat.Mode.TRIANGLES, RenderPipelines.ENTITY_SOLID).overlay().lightmap());
        it.put(SkinVertexFormat.SKIN_MESH_FACE_LIGHTING_TRANSLUCENT, () -> _builder(DefaultVertexFormat.NEW_ENTITY, VertexFormat.Mode.TRIANGLES, RenderPipelines.ENERGY_SWIRL).overlay().lightmap().emissive());
    });


    public AbstractRenderTypeImpl(String name, RenderType delegate, boolean affectsCrumbling, boolean sortUpload, Runnable setupRenderState, Runnable clearRenderState) {
        super(name, delegate.bufferSize(), affectsCrumbling, sortUpload, null, null);
    }

    public static IRenderType.Builder builder(SkinVertexFormat format) {
        var provider = MAPPER.get(format);
        if (provider != null) {
            var builder = provider.get();
            builder.format(format);
            return builder;
        }
        throw new RuntimeException("can't supported render mode");
    }

    private static RenderPipeline.Snippet _snippet(RenderPipeline pipeline) {
        return new RenderPipeline.Snippet(
                Optional.of(pipeline.getVertexShader()),
                Optional.of(pipeline.getFragmentShader()),
                Optional.of(pipeline.getShaderDefines()),
                Optional.of(pipeline.getSamplers()),
                Optional.of(pipeline.getUniforms()),
                pipeline.getBlendFunction(),
                Optional.of(pipeline.getDepthTestFunction()),
                Optional.of(pipeline.getPolygonMode()),
                Optional.of(pipeline.isCull()),
                Optional.of(pipeline.isWriteColor()),
                Optional.of(pipeline.isWriteAlpha()),
                Optional.of(pipeline.isWriteDepth()),
                Optional.of(pipeline.getColorLogic()),
                Optional.of(pipeline.getVertexFormat()),
                Optional.of(pipeline.getVertexFormatMode())
        );
    }

    private static Builder _builder(VertexFormat format, VertexFormat.Mode mode, RenderPipeline pipeline) {
        var snippet = _snippet(pipeline);
        return new Builder(RenderPipeline.builder(snippet).withVertexFormat(format, mode));
    }

    private static class Builder extends AbstractRenderType.Builder {

        private static final Map<IRenderType.Target, OutputStateShard> OUTPUTS = Collections.immutableMap(it -> {
            it.put(IRenderType.Target.MAIN, MAIN_TARGET);
            it.put(IRenderType.Target.OUTLINE, OUTLINE_TARGET);
            it.put(IRenderType.Target.TRANSLUCENT, ITEM_ENTITY_TARGET);
            it.put(IRenderType.Target.CLOUDS, WEATHER_TARGET);
            it.put(IRenderType.Target.WEATHER, WEATHER_TARGET);
            it.put(IRenderType.Target.PARTICLES, ITEM_ENTITY_TARGET);
            it.put(IRenderType.Target.ITEM_ENTITY, ITEM_ENTITY_TARGET);
        });

        private static final Map<IRenderType.PolygonMode, PolygonMode> POLYGON_MODES = Collections.immutableMap(it -> {
            it.put(IRenderType.PolygonMode.FILL, PolygonMode.FILL);
            it.put(IRenderType.PolygonMode.WIREFRAME, PolygonMode.WIREFRAME);
        });

        private static final Map<IRenderType.BlendMode, BlendFunction> BLEND_FUNCTIONS = Collections.immutableMap(it -> {
            //it.put(IRenderType.BlendMode.NONE, new BlendFunction("default_transparency", Objects::hash, Objects::hash));
            //it.put(IRenderType.BlendMode.NORMAL, NO_TRANSPARENCY);
            it.put(IRenderType.BlendMode.LIGHTNING, BlendFunction.LIGHTNING);
            it.put(IRenderType.BlendMode.GLINT, BlendFunction.GLINT);
            it.put(IRenderType.BlendMode.OVERLAY, BlendFunction.OVERLAY);
            it.put(IRenderType.BlendMode.TRANSLUCENT, BlendFunction.TRANSLUCENT);
            it.put(IRenderType.BlendMode.TRANSLUCENT_PREMULTIPLIED_ALPHA, BlendFunction.TRANSLUCENT_PREMULTIPLIED_ALPHA);
            it.put(IRenderType.BlendMode.ADDITIVE, BlendFunction.ADDITIVE);
            it.put(IRenderType.BlendMode.ENTITY_OUTLINE_BLIT, BlendFunction.ENTITY_OUTLINE_BLIT);
        });

        private static final Map<IRenderType.LogicOp, LogicOp> LOGIC_OPS = Collections.immutableMap(it -> {
            it.put(IRenderType.LogicOp.NONE, LogicOp.NONE);
            it.put(IRenderType.LogicOp.OR_REVERSE, LogicOp.OR_REVERSE);
        });

        private static final Map<IRenderType.DepthTestMode, DepthTestFunction> DEPTH_TEST_MODES = Collections.immutableMap(it -> {
            it.put(IRenderType.DepthTestMode.NO_DEPTH_TEST, DepthTestFunction.NO_DEPTH_TEST);
            it.put(IRenderType.DepthTestMode.EQUAL_DEPTH_TEST, DepthTestFunction.EQUAL_DEPTH_TEST);
            it.put(IRenderType.DepthTestMode.LEQUAL_DEPTH_TEST, DepthTestFunction.LEQUAL_DEPTH_TEST);
            it.put(IRenderType.DepthTestMode.LESS_DEPTH_TEST, DepthTestFunction.LESS_DEPTH_TEST);
            it.put(IRenderType.DepthTestMode.GREATER_DEPTH_TEST, DepthTestFunction.GREATER_DEPTH_TEST);
        });

        private boolean isOutline = false;
        private boolean affectsCrumbling = false;
        private boolean sortOnUpload = false;

        private ResourceLocation usedTexture;

        private final StateBuilder stateBuilder = new StateBuilder();
        private final RenderPipeline.Builder pipelineBuilder;
        private final ArrayList<RenderStateShard> customStates = new ArrayList<>();

        private Builder(RenderPipeline.Builder pipelineBuilder) {
            this.pipelineBuilder = pipelineBuilder;
            this.setupDefault();
        }

        private void setupDefault() {
            pipelineBuilder.withCull(false);
            // stateBuilder.setAlphaState(DEFAULT_ALPHA);
        }

        @Override
        public Builder texture(IResourceLocation texture, boolean blur, boolean mipmap) {
            usedTexture = texture.toLocation();
            stateBuilder.setTextureState(new TextureStateShard(texture.toLocation(), mipmap));
            return this;
        }

        @Override
        public Builder target(IRenderType.Target target) {
            stateBuilder.setOutputState(OUTPUTS.getOrDefault(target, MAIN_TARGET));
            super.target(target);
            return this;
        }

        @Override
        public Builder colorWrite(boolean writeColor, boolean writeAlpha) {
            pipelineBuilder.withColorWrite(writeColor, writeAlpha);
            return this;
        }

        @Override
        public Builder depthWrite(boolean writeDepth) {
            pipelineBuilder.withDepthWrite(writeDepth);
            return this;
        }


        @Override
        public Builder colorLogic(IRenderType.LogicOp op) {
            pipelineBuilder.withColorLogic(LOGIC_OPS.get(op));
            return this;
        }

        @Override
        public Builder depthTest(IRenderType.DepthTestMode testMode) {
            pipelineBuilder.withDepthTestFunction(DEPTH_TEST_MODES.get(testMode));
            return this;
        }

        @Override
        public Builder polygonMode(IRenderType.PolygonMode mode) {
            pipelineBuilder.withPolygonMode(POLYGON_MODES.get(mode));
            return this;
        }

        @Override
        public Builder polygonOffset(float factor, float units) {
            customStates.add(new TexturingStateShard("polygon_offset", () -> {
                GL11.glEnable(GL11.GL_POLYGON_OFFSET_FILL);
                GL11.glPolygonOffset(factor, units);
            }, () -> {
                GL11.glPolygonOffset(0, 0);
                GL11.glDisable(GL11.GL_POLYGON_OFFSET_FILL);
            }));
            return this;
        }

        @Override
        public Builder lineWidth(float width) {
            stateBuilder.setLineState(new LineStateShard(OptionalDouble.of(width)));
            return this;
        }

        @Override
        public Builder stroke(float width) {
            customStates.add(new TexturingStateShard("stroke_line", () -> {
                GL11.glPolygonMode(GL11.GL_FRONT_AND_BACK, GL11.GL_LINE);
                GL11.glLineWidth(width);
            }, () -> {
                GL11.glPolygonMode(GL11.GL_FRONT_AND_BACK, GL11.GL_FILL);
            }));
            return this;
        }

        @Override
        public Builder cull() {
            pipelineBuilder.withCull(true);
            return this;
        }

        @Override
        public Builder blend(IRenderType.BlendMode blendFunction) {
            var blendFunction1 = BLEND_FUNCTIONS.get(blendFunction);
            if (blendFunction1 != null) {
                pipelineBuilder.withBlend(blendFunction1);
            } else {
                pipelineBuilder.withoutBlend();
            }
            return this;
        }

        @Override
        public Builder emissive() {
            super.emissive();
            return this;
        }

        @Override
        public Builder lightmap() {
            stateBuilder.setLightmapState(LIGHTMAP);
            return this;
        }

        @Override
        public Builder overlay() {
            stateBuilder.setOverlayState(OVERLAY);
            return this;
        }

        @Override
        public Builder outline() {
            isOutline = true;
            return this;
        }

        @Override
        public Builder crumbling() {
            affectsCrumbling = true;
            return this;
        }

        @Override
        public Builder sortOnUpload() {
            sortOnUpload = true;
            return this;
        }

        private CompositeState state() {
            if (!customStates.isEmpty()) {
                stateBuilder.setTexturingState(new TexturingStateShard("custom_texturing", () -> customStates.forEach(RenderStateShard::setupRenderState), () -> customStates.forEach(RenderStateShard::clearRenderState)));
            }
            return stateBuilder.createCompositeState(isOutline);
        }

        @Override
        public AbstractRenderType build(String name) {
            var pipeline = pipelineBuilder.withLocation(ModConstants.key("pipeline/" + name).toLocation()).build();
            var renderType = AbstractRenderType.of(RenderType.create(ModConstants.key("rendertype/" + name).toString(), 256, affectsCrumbling, sortOnUpload, pipeline, state()));
            renderType.apply(updater);
            return renderType;
        }
    }

    private static class StateBuilder extends CompositeState.CompositeStateBuilder {

        @Override
        public StateBuilder setLayeringState(LayeringStateShard layeringStateShard) {
            super.setLayeringState(layeringStateShard);
            return this;
        }

        @Override
        public StateBuilder setLightmapState(LightmapStateShard lightmapStateShard) {
            super.setLightmapState(lightmapStateShard);
            return this;
        }

        @Override
        public StateBuilder setLineState(LineStateShard lineStateShard) {
            super.setLineState(lineStateShard);
            return this;
        }

        @Override
        public StateBuilder setOutputState(OutputStateShard outputStateShard) {
            super.setOutputState(outputStateShard);
            return this;
        }

        @Override
        public StateBuilder setOverlayState(OverlayStateShard overlayStateShard) {
            super.setOverlayState(overlayStateShard);
            return this;
        }

        @Override
        public StateBuilder setTextureState(EmptyTextureStateShard emptyTextureStateShard) {
            super.setTextureState(emptyTextureStateShard);
            return this;
        }

        @Override
        public StateBuilder setTexturingState(TexturingStateShard texturingStateShard) {
            super.setTexturingState(texturingStateShard);
            return this;
        }

        @Override
        public CompositeState createCompositeState(boolean bl) {
            return super.createCompositeState(bl);
        }
    }
}
