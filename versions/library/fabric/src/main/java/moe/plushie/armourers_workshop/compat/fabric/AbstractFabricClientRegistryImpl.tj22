package moe.plushie.armourers_workshop.compat.fabric;

import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.compat.client.AbstractClientRegistry;
import moe.plushie.armourers_workshop.compat.client.gui.render.AbstractComposeGuiGraphicsState;
import moe.plushie.armourers_workshop.compat.client.gui.render.AbstractComposeGuiGraphicsRenderer;
import net.minecraft.client.renderer.GameRenderer;

@Available("[1.22, )")
public abstract class AbstractFabricClientRegistryImpl extends AbstractClientRegistry {

    @Override
    protected void init() {
        super.init();
        GameRenderer.registerPictureInPictureRendererFA(AbstractComposeGuiGraphicsState.class, AbstractComposeGuiGraphicsRenderer::new);
    }
}
