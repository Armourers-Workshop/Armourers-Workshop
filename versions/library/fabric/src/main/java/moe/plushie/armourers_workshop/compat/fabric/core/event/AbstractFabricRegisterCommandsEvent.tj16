package moe.plushie.armourers_workshop.compat.fabric.core.event;

import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.api.registry.IEventHandler;
import moe.plushie.armourers_workshop.init.event.common.RegisterCommandsEvent;
import net.fabricmc.fabric.api.command.v1.CommandRegistrationCallback;

@Available("[16, 19)")
public class AbstractFabricRegisterCommandsEvent {

    public static IEventHandler<RegisterCommandsEvent> registryFactory() {
        return (priority, receiveCancelled, subscriber) -> CommandRegistrationCallback.EVENT.register(((dispatcher, dedicated) -> subscriber.accept(dispatcher::register)));
    }
}
