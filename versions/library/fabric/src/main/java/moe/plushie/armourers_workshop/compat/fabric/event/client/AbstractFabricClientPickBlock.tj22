package moe.plushie.armourers_workshop.compat.fabric.event.client;

import moe.plushie.armourers_workshop.api.annotation.Available;
import net.fabricmc.fabric.api.event.Event;
import net.fabricmc.fabric.api.event.EventFactory;
import net.minecraft.world.entity.player.Player;
import net.minecraft.world.item.ItemStack;
import net.minecraft.world.phys.HitResult;

@Available("[1.22, )")
public class AbstractFabricClientPickBlock {

    // TODO: No IMPL - 1.22
    public static final Event<Gather> EVENT = EventFactory.createArrayBacked(Gather.class, callbacks -> (player, result) -> {
        for (var callback : callbacks) {
            return callback.handle(player, result);
        }
        return ItemStack.EMPTY;
    });

    public interface Gather {
        ItemStack handle(Player player, HitResult result);
    }
}
